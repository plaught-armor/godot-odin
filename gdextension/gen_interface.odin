// Fills every proc variable above from the engine's get_proc_address. A function this
// engine lacks stays nil.
load_interface :: proc(get_proc_address: InterfaceGetProcAddress) {
	get_godot_version = auto_cast get_proc_address("get_godot_version")
	get_godot_version2 = auto_cast get_proc_address("get_godot_version2")
	mem_alloc = auto_cast get_proc_address("mem_alloc")
	mem_realloc = auto_cast get_proc_address("mem_realloc")
	mem_free = auto_cast get_proc_address("mem_free")
	mem_alloc2 = auto_cast get_proc_address("mem_alloc2")
	mem_realloc2 = auto_cast get_proc_address("mem_realloc2")
	mem_free2 = auto_cast get_proc_address("mem_free2")
	print_error = auto_cast get_proc_address("print_error")
	print_error_with_message = auto_cast get_proc_address("print_error_with_message")
	print_warning = auto_cast get_proc_address("print_warning")
	print_warning_with_message = auto_cast get_proc_address("print_warning_with_message")
	print_script_error = auto_cast get_proc_address("print_script_error")
	print_script_error_with_message = auto_cast get_proc_address("print_script_error_with_message")
	get_native_struct_size = auto_cast get_proc_address("get_native_struct_size")
	variant_new_copy = auto_cast get_proc_address("variant_new_copy")
	variant_new_nil = auto_cast get_proc_address("variant_new_nil")
	variant_destroy = auto_cast get_proc_address("variant_destroy")
	variant_call = auto_cast get_proc_address("variant_call")
	variant_call_static = auto_cast get_proc_address("variant_call_static")
	variant_evaluate = auto_cast get_proc_address("variant_evaluate")
	variant_set = auto_cast get_proc_address("variant_set")
	variant_set_named = auto_cast get_proc_address("variant_set_named")
	variant_set_keyed = auto_cast get_proc_address("variant_set_keyed")
	variant_set_indexed = auto_cast get_proc_address("variant_set_indexed")
	variant_get = auto_cast get_proc_address("variant_get")
	variant_get_named = auto_cast get_proc_address("variant_get_named")
	variant_get_keyed = auto_cast get_proc_address("variant_get_keyed")
	variant_get_indexed = auto_cast get_proc_address("variant_get_indexed")
	variant_iter_init = auto_cast get_proc_address("variant_iter_init")
	variant_iter_next = auto_cast get_proc_address("variant_iter_next")
	variant_iter_get = auto_cast get_proc_address("variant_iter_get")
	variant_hash = auto_cast get_proc_address("variant_hash")
	variant_recursive_hash = auto_cast get_proc_address("variant_recursive_hash")
	variant_hash_compare = auto_cast get_proc_address("variant_hash_compare")
	variant_booleanize = auto_cast get_proc_address("variant_booleanize")
	variant_duplicate = auto_cast get_proc_address("variant_duplicate")
	variant_stringify = auto_cast get_proc_address("variant_stringify")
	variant_get_type = auto_cast get_proc_address("variant_get_type")
	variant_has_method = auto_cast get_proc_address("variant_has_method")
	variant_has_member = auto_cast get_proc_address("variant_has_member")
	variant_has_key = auto_cast get_proc_address("variant_has_key")
	variant_get_object_instance_id = auto_cast get_proc_address("variant_get_object_instance_id")
	variant_get_type_name = auto_cast get_proc_address("variant_get_type_name")
