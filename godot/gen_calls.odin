// Describes each parameter of `P` from index `FIRST` on into `d`, by `describe_param`.
@(private)
describe_params :: proc($P: typeid, $FIRST: int, d: ^Params) {
	N :: intrinsics.type_proc_parameter_count(P)
	when N > FIRST + 0 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 0), 0, d) }
	when N > FIRST + 1 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 1), 1, d) }
	when N > FIRST + 2 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 2), 2, d) }
	when N > FIRST + 3 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 3), 3, d) }
	when N > FIRST + 4 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 4), 4, d) }
	when N > FIRST + 5 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 5), 5, d) }
	when N > FIRST + 6 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 6), 6, d) }
	when N > FIRST + 7 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 7), 7, d) }
	when N > FIRST + 8 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 8), 8, d) }
	when N > FIRST + 9 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 9), 9, d) }
	when N > FIRST + 10 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 10), 10, d) }
	when N > FIRST + 11 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 11), 11, d) }
	when N > FIRST + 12 { describe_param(intrinsics.type_proc_parameter_type(P, FIRST + 12), 12, d) }
}
